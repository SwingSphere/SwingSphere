# Public browser-safe Supabase credentials.
# Copy these names into .env.local and fill them from Supabase Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Feedback persistence. Use `supabase` for real RPC-backed feedback.
# `mock` is development-only, intentionally stores prototype records in localStorage,
# and is rejected by production builds. If omitted while Supabase credentials are
# configured, feedback selects Supabase. Failures never fall back to mock records.
VITE_FEEDBACK_REPOSITORY=supabase

# Launch review UX. Keep false/omitted for the inline Reddit-style composer.
# Set true later to restore the advanced visit-date + structured-signal workflow.
VITE_ENABLE_ADVANCED_REVIEW_FLOW=false

# Deployment presentation mode.
# Use `coming-soon` for the public production domain and `full` for protected preview deployments.
VITE_SITE_MODE=full

# Mapbox browser access token used by the legacy MapEngineBase views.
# Keep the real token in .env.local / deployment environment, not in Git.
VITE_MAPBOX_ACCESS_TOKEN=your-public-mapbox-token

# Existing SwingSphere integrations (do not commit real values).
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NEXT_PUBLIC_CLOUDFLARE_IMAGES_ACCOUNT_HASH=
