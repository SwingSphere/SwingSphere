{
  "name": "swingsphere:-nightlife-discovery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:building-verification": "node scripts/run-typescript-entry.mjs test tests/buildingVerification.test.ts",
    "test:mobile": "node scripts/run-typescript-entry.mjs test tests/devMobileRouting.test.ts && node --test tests/mobileGlobeRuntimePolicy.test.mjs",
    "test:sitemap": "node scripts/run-typescript-entry.mjs test tests/devSitemap.test.ts",
    "test:hybrid-geospatial": "node --test tests/hybridGeospatialCalibration.test.mjs tests/countryBoundaryCoverage.test.mjs",
    "typecheck:mobile": "tsc -p tsconfig.mobile.json",
    "audit:building-verification": "node scripts/run-typescript-entry.mjs run scripts/audit-building-verification.ts",
    "verify:feedback": "node scripts/verify-feedback-foundation.mjs",
    "build:cloudflare": "vite build --mode cloudflare",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler pages dev dist",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy dist",
    "supabase:backfill-listings": "node scripts/backfill-listings-to-supabase.mjs",
    "supabase:backfill-entity-catalog": "node scripts/backfill-entity-catalog-to-supabase.mjs",
    "cf:setup-image-variants": "node scripts/setup-cloudflare-image-variants.mjs"
  },
  "dependencies": {
    "@react-spring/three": "^9.7.5",
    "@react-spring/web": "^9.7.5",
    "@react-three/drei": "9.120.9",
    "@react-three/fiber": "8.17.6",
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/postcss": "^4.1.17",
    "cobe": "^0.6.5",
    "framer-motion": "10.16.4",
    "h3-js": "^4.1.0",
    "leaflet": "^1.9.4",
    "leva": "^0.10.1",
    "lucide-react": "^0.554.0",
    "maplibre-gl": "^5.24.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-leaflet": "4.2.1",
    "react-router-dom": "^6.30.2",
    "recharts": "2.9.0",
    "supercluster": "^8.0.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/supercluster": "^7.1.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.112.0"
  }
}
